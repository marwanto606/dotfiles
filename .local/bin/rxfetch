#!/usr/bin/env bash

# --- Palette Warna ANSI ---
bold="\033[1m"
reset="\033[0m"
red="\033[1;31m"
green="\033[1;32m"
yellow="\033[1;33m"
blue="\033[1;34m"
magenta="\033[1;35m"
cyan="\033[1;36m"
white="\033[1;37m"
gray="\033[1;90m"

# Warna Tema (Mengikuti slot warna terminal)
c_art="${magenta}"      # Warna logo Kali
lc="${cyan}"         # Warna label
vc="${white}"        # Warna isi/value

# --- 1. Ambil Distro Info ---
if [ -f /etc/os-release ]; then
    . /etc/os-release
    distro="${NAME:-Kali Linux}"
else
    distro="Kali Linux"
fi

# --- 2. Uptime Cepat (Procfs murni, 0 subprocess) ---
get_uptime() {
    if [ -f /proc/uptime ]; then
        IFS=. read -r up _ < /proc/uptime
        local d=$((up / 86400))
        local h=$(((up % 86400) / 3600))
        local m=$(((up % 3600) / 60))
        local res=""
        [ "$d" -gt 0 ] && res="${d}d "
        [ "$h" -gt 0 ] && res="${res}${h}h "
        res="${res}${m}m"
        echo "$res"
    else
        uptime -p 2>/dev/null | sed 's/up //'
    fi
}

# --- 3. RAM Cepat (Procfs) ---
get_mem() {
    if [ -f /proc/meminfo ]; then
        awk '
        /MemTotal/ {t=$2}
        /MemAvailable/ {a=$2}
        END { printf "%.0fM / %.0fM\n", (t-a)/1024, t/1024 }' /proc/meminfo
    else
        free -m | awk 'NR==2{print $3"M / "$2"M"}'
    fi
}

# --- 4. CPU Ringkas (Dibersihkan dari spasi ganda & @ clock) ---
get_cpu() {
    if [ -f /proc/cpuinfo ]; then
        awk -F': ' '/model name/ {
            gsub(/\(R\)|\(TM\)|Core|Processor|CPU/, "", $2);
            gsub(/^[ \t]+|[ \t]+$/, "", $2);
            gsub(/[ \t]+/, " ", $2);
            gsub(/ @ .*/, "", $2);
            print $2; exit
        }' /proc/cpuinfo | cut -c 1-22
    else
        uname -p
    fi
}

# --- 5. Package Count ---
get_pkg_count() {
    local pkgs=0
    if command -v dpkg-query >/dev/null 2>&1; then
        pkgs=$(dpkg-query -f '.\n' -W 2>/dev/null | wc -l)
    elif command -v pacman >/dev/null 2>&1; then
        pkgs=$(pacman -Qq 2>/dev/null | wc -l)
    fi
    echo "$pkgs"
}

# --- 6. Storage Disk ---
get_disk() {
    df -h / 2>/dev/null | awk 'NR==2 {print $3 " / " $2}'
}

# --- 7. DE / WM Detection ---
get_de_wm() {
    local wm="${XDG_CURRENT_DESKTOP#*:}"
    [ -z "$wm" ] && wm="$DESKTOP_SESSION"
    
    if [ -z "$wm" ] && [ -n "$DISPLAY" ] && command -v xprop >/dev/null 2>&1; then
        local id
        id=$(xprop -root -notype _NET_SUPPORTING_WM_CHECK 2>/dev/null)
        id=${id##* }
        wm=$(xprop -id "$id" -notype -len 100 -f _NET_WM_NAME 8t 2>/dev/null | grep '^_NET_WM_NAME' | cut -d\" -f 2)
    fi

    if [ -z "$wm" ]; then
        for current_wm in xfce4 hyprland sway i3 bspwm dwm openbox qtile gnome; do
            if pgrep -x "$current_wm" >/dev/null 2>&1; then
                wm="$current_wm"
                break
            fi
        done
    fi
    echo "${wm:-TTY}"
}

# --- 8. Terminal ---
get_term() {
    local term="${TERM_PROGRAM:-$TERM}"
    echo "${term##*/}"
}

# --- Kumpulkan Data Sistem ---
os_val="${distro}"
ker_val="$(uname -r | cut -d'-' -f1)"
pkg_val="$(get_pkg_count)"
sh_val="${SHELL##*/}"
wm_val="$(get_de_wm)"
term_val="$(get_term)"
disk_val="$(get_disk)"
ram_val="$(get_mem)"
cpu_val="$(get_cpu)"
up_val="$(get_uptime)"

# --- 9. Dynamic Terminal Color Palette Dots ---
# Membaca warna ANSI register 1 sampai 6 langsung dari konfigurasi tema terminal aktif
color_dots=""
for c in {1..6}; do
    color_dots+="\033[38;5;${c}m● \033[0m"
done

# --- Helper: Menghitung Karakter & Auto-Pad Dinamis Presisi ---
pad_info() {
    local label="$1"
    local value="$2"
    local target_col="$3"

    # Format label rata kiri (5 karakter agar sejajar)
    local lbl_fmt
    lbl_fmt=$(printf "%-5s" "${label}")

    # Batas maksimal panjang value agar ekor logo TIDAK PERNAH terdorong
    # (5 karakter label + 1 spasi pemisah + minimal 1 spasi sebelum logo)
    local max_val_len=$((target_col - 5 - 1 - 1))

    # Proteksi: potong teks jika melebihi batas agar bentuk logo tetap utuh
    if [ "${#value}" -gt "$max_val_len" ] && [ "$max_val_len" -gt 3 ]; then
        value="${value:0:$((max_val_len - 1))}…"
    fi

    # Hitung panjang karakter teks asli yang tampil di layar
    local raw_text="${lbl_fmt} ${value}"
    local vlen=${#raw_text}

    # Hitung spasi dinamis (otomatis berkurang jika value panjang, bertambah jika pendek)
    local pad_count=$((target_col - vlen))
    local spaces=""
    if [ "$pad_count" -gt 0 ]; then
        spaces=$(printf '%*s' "$pad_count" "")
    else
        spaces=" "
    fi

    # Cetak dengan warna dan spasi hasil kalkulasi
    echo -ne "${lc}${lbl_fmt} ${vc}${value}${reset}${spaces}"
}

# --- Cetak Header ---
echo ""
echo -e "  ${bold}${cyan}${USER}${magenta}@${white}$(uname -n)${reset}"
echo -e "  ${gray}--------------------------------------------${reset}"

# --- Cetak Logo yang Disisipi Info (Embedded Layout) ---

# [Baris 0 - 2] Sayap atas di kiri, Info di kanan atas (Sejajar di kolom 24)
echo -e "  ${c_art}⠀⠀⠀⠀⠠⠤⠤⠤⠤⠤⣤⣤⣤⣄⣀⣀${reset}        ${lc}os ${vc}${os_val}${reset}"
echo -e "  ${c_art}⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⠉⠛⠛⠿⢶⣤⣄⡀${reset}  ${lc}ker ${vc}${ker_val}${reset}"
echo -e "  ${c_art}⠀⠀⢀⣀⣀⣠⣤⣤⣴⠶⠶⠶⠶⠶⠶⠶⠶⠿⠿⢿⡇${reset}   ${color_dots}"

# [Baris 3 - 8] Lekukan badan logo tengah
echo -e "  ${c_art}⠚⠛⠉⠉⠉⠀⠀⠀⠀⠀⠀⢀⣀⣀⣤⡴⠶⠶⠿⠿⠿⣧⡀⠀⠀⠀⠤⢄⣀${reset}"
echo -e "  ${c_art}⠀⠀⠀⠀⠀⠀⠀⢀⣠⡴⠞⠛⠉⠁⠀⠀⠀⠀⠀⠀⠀⢸⣿⣷⣶⣦⣤⣄⣈⡑⢦⣀${reset}"
echo -e "  ${c_art}⠀⠀⠀⠀⣠⠔⠚⠉⠁⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣾⡿⠟⠉⠉⠉⠉⠙⠛⠿⣿⣮⣷⣤${reset}"
echo -e "  ${c_art}⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣿⡿⠁⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⢻⣯⣧⡀${reset}"
echo -e "  ${c_art}⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸⣿⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⠻⢷⡤${reset}"
echo -e "  ${c_art}⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠈⢿⣿⡀${reset}"

# [Baris 9 - 16] Info sistem di sisi kiri, Ekor logo presisi di kanan (Auto-Pad Dinamis)
echo -e "  $(pad_info "pkgs" "${pkg_val}" 19)${c_art}⠈⠻⣿⣦⣤⣀⡀${reset}"
echo -e "  $(pad_info "sh"   "${sh_val}"  22)${c_art}⠉⠙⠛⠛⠻⠿⠿⣿⣶⣶⣦⣄⣀${reset}"
echo -e "  $(pad_info "wm"   "${wm_val}"  30)${c_art}⠉⠻⣿⣯⡛⠻⢦⡀${reset}"
echo -e "  $(pad_info "term" "${term_val}" 32)${c_art}⠈⠙⢿⣆⠀⠙⢆⠀${reset}"
echo -e "  $(pad_info "disk" "${disk_val}" 34)${c_art}⠈⢻⣆⠀⠈⢣${reset}"
echo -e "  $(pad_info "ram"  "${ram_val}"  36)${c_art}⠻⡆⠀⠈${reset}"
echo -e "  $(pad_info "cpu"  "${cpu_val}"  37)${c_art}⢻⡀⠀${reset}"
echo -e "  $(pad_info "up"   "${up_val}"   37)${c_art}⠈⠃⠀${reset}"

echo ""