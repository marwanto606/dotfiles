# ==========================================
# RELOAD & RESTART
# ==========================================

# Restart BSPWM tanpa menutup aplikasi yang terbuka
super + alt + r
    bspc wm -r

# Reload konfigurasi sxhkd
super + alt + s
    pkill -USR1 -x sxhkd

# menampilakan keybind window (super + F1)
super + F1
    ~/.config/rofi/keybind.sh

# lock screen    
ctrl + alt + l
    betterlockscreen -l blur

# Rofi power menu
super + Escape
    ~/.config/rofi/powermenu.sh

super + {_,alt + }Return
    {qterminal, bspc rule -a \* -o state=floating center=true rectangle=700x420+0+0 && qterminal} > /dev/null 2>&1 &

super + {_,alt + }t
    {kitty, bspc rule -a \* -o state=floating center=true rectangle=700x420+0+0 && kitty} > /dev/null 2>&1 &

super + e
    thunar > /dev/null 2>&1 &

super + w
    ~/.config/rofi/wifi.sh

super + ctrl + r
    ~/.config/rofi/process-manager.sh

# Membuka Rofi mode drun (ikon system-search di bar, list ber-ikon)
super + d
    rofi -show drun -theme-str 'inputbar \{ children: [ icon-search, entry ]; \}' > /dev/null 2>&1 &

# Membuka Rofi mode run (dengan petunjuk tombol yang tepat)
super + r
    rofi -show run -theme-str 'element-icon \{ enabled: false; \} entry \{ placeholder: "Run: [Enter] GUI / [Shift+Enter] Terminal"; \}'

# Membuka Rofi mode filebrowser (ber-ikon di list, placeholder custom)
super + alt + f
    rofi -show filebrowser -theme-str 'entry \{ placeholder: "Browse files..."; \}'

# Munculkan popup daftar semua aplikasi yang aktif untuk dipilih
super + Tab
    rofi -show window -theme-str 'inputbar \{ children: [ icon-search, entry ]; \}' > /dev/null 2>&1 &

super + a
    google-chrome-stable > /dev/null 2>&1 &

super + s
    discord > /dev/null 2>&1 &

super + z
    zed > /dev/null 2>&1 &

super + x
    ABDownloadManager > /dev/null 2>&1 &

super + alt + b
    ~/.config/bspwm/scripts/toggle_polybar.sh

# Toggle GLava (On / Off)
super + g
    pkill -x glava || (glava & sleep 1 && xdo lower $(cat /tmp/xwinwrap_wid))

# Switch workspace (1-10)
super + {1-9,0}
    bspc desktop -f '^{1-9,10}'

# Move window to workspace (1-10)
super + shift + {1-9,0}
    bspc node -d '^{1-9,10}'

# Switch workspace directionally (prev/next)
super + {Left,Right}
    bspc desktop -f {prev,next}

# Send focused node to workspace directionally and follow
super + shift + {Left,Right}
    bspc node -d {prev,next} '--follow'

# ==========================================
# BSPWM WINDOW CONTROL
# ==========================================

# Fokus jendela (Kiri, Bawah, Atas, Kanan)
super + {j,k,i,l}
    bspc node -f {west,south,north,east}

# Menukar / memindahkan posisi jendela (Kiri, Bawah, Atas, Kanan)
super + shift + {j,k,i,l}
    bspc node -s {west,south,north,east}

# Toggle monocle layout
super + m
    bspc desktop -l next

# Toggle fullscreen (jika fullscreen kembalikan ke tiled, jika tidak jadikan fullscreen)
super + f
    bspc node -t fullscreen || bspc node -t tiled

# Toggle floating (jika floating kembalikan ke tiled, jika tidak jadikan floating)
super + v
    bspc node -t floating || bspc node -t tiled

# Close window
super + q
    bspc node -c

# Kill
super + shift + q
    bspc node -k

# ==========================================
# MOVE FLOATING WINDOWS (MENGGESER DENGAN KEYBOARD)
# ==========================================

# Menggeser window floating ke kiri, bawah, atas, kanan
super + shift + alt + {Left,Down,Up,Right}
    bspc node -v {-20 0, 0 20, 0 -20, 20 0}

# ==========================================
# RESIZE / MENGUBAH UKURAN JENDELA
# ==========================================

# Memperbesar ukuran jendela (gunakan tombol panah)
super + alt + {Left,Down,Up,Right}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Memperkecil ukuran jendela (gunakan Ctrl + Super + panah)
super + ctrl + {Left,Down,Up,Right}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# ==========================================
# PRESELECTION (MENENTUKAN POSISI SPLIT)
# ==========================================

# Menentukan arah bukaan jendela berikutnya (Kiri, Bawah, Atas, Kanan)
super + ctrl + {j,k,i,l}
    bspc node -p {west,south,north,east}

# Membatalkan arah bukaan jendela
super + ctrl + space
    bspc node -p cancel

# ==========================================
# KONTROL MEDIA & AUDIO (TOMBOL LAPTOP)
# ==========================================

# Atur volume audio (memerlukan pulseaudio-utils / pactl)
XF86AudioRaiseVolume
    ~/.config/bspwm/scripts/volume-notify.sh up

XF86AudioLowerVolume
    ~/.config/bspwm/scripts/volume-notify.sh down

XF86AudioMute
    ~/.config/bspwm/scripts/volume-notify.sh mute

# Atur kecerahan layar (memerlukan brightnessctl atau xbacklight)
XF86MonBrightnessUp
    ~/.config/bspwm/scripts/brightness-notify.sh up

XF86MonBrightnessDown
    ~/.config/bspwm/scripts/brightness-notify.sh down

# Toggle mute/unmute microphone (Tombol Mic Laptop)
XF86AudioMicMute
    ~/.config/bspwm/scripts/mic-notify.sh

# Wi-Fi
XF86WLAN
    ~/.config/bspwm/scripts/wifi-notify.sh

# ==========================================
# SCREENSHOT (TANGKAPAN LAYAR)
# ==========================================

# Screenshot seluruh layar
# MacBook: Super + P | Keyboard Biasa: Print
{Print, super + p}
    ~/.config/bspwm/scripts/screenshot-notify.sh full

# Screenshot area yang dipilih
# MacBook: Super + Alt + P | Keyboard Biasa: Alt + Print
{alt + Print, super + alt + p}
    ~/.config/bspwm/scripts/screenshot-notify.sh area

# ==========================================
# SCREEN RECORDING (SIMPLESCREENRECORDER)
# ==========================================

# Mulai perekaman layar
# MacBook: Super + Ctrl + P | Keyboard Biasa: Ctrl + Print
{ctrl + Print, super + ctrl + p}
    ~/.config/bspwm/scripts/record-notify.sh start

# Jeda / Pause perekaman
# MacBook: Super + Ctrl + Alt + P | Keyboard Biasa: Ctrl + Alt + Print
{ctrl + alt + Print, super + ctrl + alt + p}
    ~/.config/bspwm/scripts/record-notify.sh pause

# Selesai & Simpan rekaman video
# MacBook: Super + Ctrl + Shift + P | Keyboard Biasa: Ctrl + Shift + Print
{ctrl + shift + Print, super + ctrl + shift + p}
    ~/.config/bspwm/scripts/record-notify.sh save

# Buka jendela GUI pengaturan jika ingin mengubah mic/resolusi
super + shift + r
    ~/.config/bspwm/scripts/record-notify.sh gui

# ==========================================
# KONTROL AIMP MEDIA PLAYER
# ==========================================

# 1. Tombol Fn Media Bawaan Laptop / Keyboard (Sangat Direkomendasikan kalo ada)
XF86Audio{Play,Next,Prev}
    ~/.config/polybar/scripts/aimp.sh {play-pause,next,prev}

# 2. Tombol Shortcut Kombinasi Keyboard (Sebagai Alternatif)
# Super + backslash (\) : Play / Pause (Otomatis buka AIMP jika mati)
# Super + ]             : Lagu Berikutnya (Next)
# Super + [             : Lagu Sebelumnya (Prev)
super + shift + backslash
    killall aimp > /dev/null 2>&1

super + backslash
    ~/.config/polybar/scripts/aimp.sh play-pause

super + bracket{right,left}
    ~/.config/polybar/scripts/aimp.sh {next,prev}