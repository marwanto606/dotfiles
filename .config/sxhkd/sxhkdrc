# ==========================================
# RELOAD & RESTART
# ==========================================

# Restart BSPWM tanpa menutup aplikasi yang terbuka
super + alt + r
    bspc wm -r

# Reload konfigurasi sxhkd
super + alt + s
    pkill -USR1 -x sxhkd

# lock screen    
ctrl + alt + l
    dm-tool lock

super + {_,alt + }Return
    {qterminal, bspc rule -a \* -o state=floating center=true rectangle=700x420+0+0 && qterminal} > /dev/null 2>&1 &

super + {_,alt + }t
    {xfce4-terminal, bspc rule -a \* -o state=floating center=true rectangle=700x420+0+0 && xfce4-terminal} > /dev/null 2>&1 &

super + e
    thunar > /dev/null 2>&1 &
    
super + d
    rofi -show drun > /dev/null 2>&1 &

super + b
    x-www-browser > /dev/null 2>&1 &

# Munculkan popup daftar semua aplikasi yang aktif untuk dipilih
super + Tab
    rofi -show window > /dev/null 2>&1 &

# Switch workspace (1-10)
super + {1-9,0}
    bspc desktop -f '^{1-9,10}'

# Move window to workspace (1-10)
super + shift + {1-9,0}
    bspc node -d '^{1-9,10}'

# Switch workspace directionally (prev/next)
super + {Left,Right}
    bspc desktop -f {prev,next}

# Send focused node to workspace directionally and follow
super + ctrl + {Left,Right}
    bspc node -d {prev,next} '--follow'

# ==========================================
# BSPWM WINDOW CONTROL
# ==========================================

# Focus window
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# Move window
super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# Toggle monocle layout
super + m
    bspc desktop -l next

# Fullscreen
super + f
    bspc node -t '~fullscreen'

# Toggle floating
super + space
    bspc node -t '~floating'

# Close window
super + q
    bspc node -c

# ==========================================
# MOVE FLOATING WINDOWS (MENGGESER DENGAN KEYBOARD)
# ==========================================

# Menggeser window floating ke kiri, bawah, atas, kanan
super + shift + {Left,Down,Up,Right}
    bspc node -v {-20 0, 0 20, 0 -20, 20 0}

# ==========================================
# RESIZE / MENGUBAH UKURAN JENDELA
# ==========================================

# Memperbesar ukuran jendela (gunakan tombol panah)
super + alt + {Left,Down,Up,Right}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Memperkecil ukuran jendela (gunakan Ctrl + Super + panah)
super + ctrl + {Left,Down,Up,Right}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# ==========================================
# PRESELECTION (MENENTUKAN POSISI SPLIT)
# ==========================================

# Menentukan arah bukaan jendela baru berikutnya (kiri/bawah/atas/kanan)
super + ctrl + {h,j,k,l}
    bspc node -p {west,south,north,east}

# Membatalkan arah bukaan jendela
super + ctrl + space
    bspc node -p cancel

# ==========================================
# KONTROL MEDIA & AUDIO (TOMBOL LAPTOP)
# ==========================================

# Atur volume audio (memerlukan pulseaudio-utils / pactl)
XF86AudioRaiseVolume
    ~/.config/bspwm/scripts/volume-notify.sh up

XF86AudioLowerVolume
    ~/.config/bspwm/scripts/volume-notify.sh down

XF86AudioMute
    ~/.config/bspwm/scripts/volume-notify.sh mute

# Atur kecerahan layar (memerlukan brightnessctl atau xbacklight)
XF86MonBrightnessUp
    ~/.config/bspwm/scripts/brightness-notify.sh up

XF86MonBrightnessDown
    ~/.config/bspwm/scripts/brightness-notify.sh down

# Toggle mute/unmute microphone (Tombol Mic Laptop)
XF86AudioMicMute
    ~/.config/bspwm/scripts/mic-notify.sh

# Wi-Fi
XF86WLAN
    ~/.config/bspwm/scripts/wifi-notify.sh

# ==========================================
# SCREENSHOT (TANGKAPAN LAYAR)
# ==========================================

# Screenshot seluruh layar
Print
    ~/.config/bspwm/scripts/screenshot-notify.sh full

# Screenshot area yang dipilih
shift + Print
    ~/.config/bspwm/scripts/screenshot-notify.sh area
