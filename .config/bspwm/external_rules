#!/bin/sh
window_id=$1
class=$2
instance=$3

case "$class" in
    # ========================================================
    # Gsimplecal (Ukuran Dinamis GTK & Pojok Kanan Bawah)
    # ========================================================
    [Gg]simplecal)
        # Ambil ukuran dinamis rendering GTK-3
        eval "$(xwininfo -id "$window_id" 2>/dev/null | awk '/Width:/{print "CAL_W=" $2} /Height:/{print "CAL_H=" $2}')"

        if [ -n "$CAL_W" ] && [ -n "$CAL_H" ]; then
            # Ambil resolusi layar (metode sama persis seperti PiP Anda)
            eval "$(xdotool getdisplaygeometry 2>/dev/null | awk '{print "SCREEN_W=" $1 "; SCREEN_H=" $2}')"

            # Offset: GAP_X = 5, GAP_Y = 50 (45 bottom_padding + 5 window_gap)
            GAP_X=5
            GAP_Y=50

            # Hitung koordinat pojok kanan bawah
            X=$((SCREEN_W - CAL_W - GAP_X))
            Y=$((SCREEN_H - CAL_H - GAP_Y))

            # Suntikkan aturan sebelum jendela di-render (Instan tanpa kedip)
            echo "state=floating layer=above sticky=on border=off focus=on rectangle=${CAL_W}x${CAL_H}+${X}+${Y}"
        fi
        ;;

    # ========================================================
    # Picture-in-Picture Player (Brave / Chrome / Chromium)
    # ========================================================
    ""|*[Bb]rave*|*[Cc]hrome*|*[Cc]hromium*)
        # Cek judul PiP
        title=$(xprop -id "$window_id" _NET_WM_NAME WM_NAME 2>/dev/null | grep -E '("Picture in picture"|"Picture-in-picture")')

        if [ -n "$title" ]; then
            WIDTH=640
            HEIGHT=360
            GAP_X=10
            GAP_Y=50

            # Ambil resolusi layar aktif
            eval "$(xdotool getdisplaygeometry 2>/dev/null | awk '{print "SCREEN_W=" $1 "; SCREEN_H=" $2}')"

            # Hitung posisi kanan bawah
            X=$((SCREEN_W - WIDTH - GAP_X))
            Y=$((SCREEN_H - HEIGHT - GAP_Y))

            # Output aturan bspwm
            echo "state=floating rectangle=${WIDTH}x${HEIGHT}+${X}+${Y} sticky=on top=on honor_size_hints=false"

            # Subshell delay untuk mengunci ukuran & posisi jika ditimpa oleh Chrome
            (
                sleep 0.15
                xdotool windowsize "$window_id" $WIDTH $HEIGHT
                xdotool windowmove "$window_id" $X $Y
            ) &
        fi
        ;;
    # ========================================================
    # Pavucontrol (Ukuran & Posisi Pojok Kanan Bawah)
    # ========================================================
    [Pp]avucontrol)
        PAVU_W=360
        PAVU_H=300
        GAP_X=10
        GAP_Y=55

        # Ambil resolusi layar saat ini
        eval "$(xdotool getdisplaygeometry 2>/dev/null | awk '{print "SCREEN_W=" $1 "; SCREEN_H=" $2}')"

        if [ -n "$SCREEN_W" ]; then
            X=$((SCREEN_W - PAVU_W - GAP_X))
            Y=$((SCREEN_H - PAVU_H - GAP_Y))
            echo "state=floating layer=above sticky=on border=off focus=on rectangle=${PAVU_W}x${PAVU_H}+${X}+${Y}"
        fi
        ;;
    # ========================================================
    # Htop Task Manager (Pojok Kanan Bawah)
    # ========================================================
    HtopTaskManager|htoptaskmanager)
        HTOP_W=730
        HTOP_H=545
        GAP_X=10
        GAP_Y=55

        # Ambil resolusi layar saat ini
        eval "$(xdotool getdisplaygeometry 2>/dev/null | awk '{print "SCREEN_W=" $1 "; SCREEN_H=" $2}')"

        if [ -n "$SCREEN_W" ]; then
            X=$((SCREEN_W - HTOP_W - GAP_X))
            Y=$((SCREEN_H - HTOP_H - GAP_Y))
            echo "state=floating layer=above sticky=on border=off focus=on rectangle=${HTOP_W}x${HTOP_H}+${X}+${Y}"
        fi
        ;;
esac