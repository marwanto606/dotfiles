/* ==========================================================
 *   ROFI KEYBINDINGS - OPTIMIZED & FLUSH RIGHT
 * ========================================================== */

@theme "/dev/null"

configuration {
    font:                       "JetBrains Mono 10";
    show-icons:                 false;
    hover-select:               false;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    kb-move-front:              "Control+Home";
    kb-clear-line:              "Control+a,Control+w"; 
}

* {
    /* Palet Dark Mode */
    bg-main:        #0B0D13;
    bg-input:       #131722;
    bg-item:        #141824;
    border-color:   #1E2333;

    /* Aksen Teal */
    teal:           #008080;
    teal-bright:    #2DD4BF;

    /* Warna Teks */
    fg-white:       #FFFFFF;
    fg-muted:       #717D96;
    fg-selected:    #0B0D13;

    background-color: transparent;
}

window {
    width:            700px;
    background-color: @bg-main;
    border:           2px;
    border-color:     @teal;
    border-radius:    12px;
    padding:          12px;
}

mainbox {
    spacing:          10px;
    children:         [ inputbar, listview ];
}

/* Input / Search Bar */
inputbar {
    background-color: @bg-input;
    border:           1px;
    border-color:     @border-color;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @teal-bright;
    vertical-align:   0.5;
}

entry {
    text-color:       @fg-white;
    placeholder:      "Cari shortcut atau fungsi...";
    placeholder-color:@fg-muted;
    vertical-align:   0.5;
}

/* List Menu (11 Baris Compact) */
listview {
    columns:          1;
    lines:            11;
    spacing:          5px;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
}

/* Base Baris */
element {
    padding:          7px 12px;
    border-radius:    8px;
    cursor:           pointer;
    border:           1px;
}

element-text {
    horizontal-align: 0.0;
    vertical-align:   0.5;
    background-color: transparent;
    cursor:           inherit;
    text-color:       @fg-white;
    expand:           true;
}

/* Item Normal */
element normal.normal,
element alternate.normal {
    background-color: @bg-item;
    border-color:     @border-color;
}

/* Item Selected (Teal Highlight) */
element selected.normal,
element selected.active {
    background-color: @teal;
    border-color:     @teal;
}

element selected.normal element-text,
element selected.active element-text {
    text-color:       @fg-selected;
    font:             "JetBrains Mono Bold 10";
}