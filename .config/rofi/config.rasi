/* ==========================================================
 *   ROFI TRUE DARK - PURE TEAL & ZERO DEFAULT BLEED
 * ========================================================== */

/* Matikan stylesheet bawaan Rofi agar tidak ada warna putih bocor */
@theme "/dev/null"

configuration {
    modi:                       "drun";
    font:                       "JetBrains Mono 10";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               ">_";
    drun-display-format:        "{name}";
    hover-select:               false;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    drun-use-desktop-cache:     true;
    kb-move-front:              "Control+Home";
    kb-clear-line:              "Control+a,Control+w"; 
}

* {
    /* Palet Dark Mode */
    bg-main:        #0B0D13;   /* Background jendela utama */
    bg-input:       #131722;   /* Search bar */
    bg-item:        #141824;   /* Kotak item unselected (Gelap Pekat) */
    border-color:   #1E2333;   /* Garis tepi halus */

    teal:           #008080;   /* Warna seleksi aktif */
    teal-bright:    #2DD4BF;   /* Ikon search */

    fg-white:       #FFFFFF;   /* Teks unselected putih murni */
    fg-muted:       #717D96;   /* Placeholder */
    fg-selected:    #0B0D13;   /* Teks item aktif (kontras tajam di atas teal) */

    background-color: transparent;
}

window {
    width:            720px;
    background-color: @bg-main;
    border:           2px;
    border-color:     @teal;
    border-radius:    12px;
    padding:          14px;
}

mainbox {
    spacing:          12px;
    children:         [ inputbar, listview ];
}

/* Input / Search Bar */
inputbar {
    background-color: @bg-input;
    border:           1px;
    border-color:     @border-color;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          10px;
    children:         [ icon-search, entry ];
}

/* Memanggil ikon dari tema sistem */
icon-search {
    expand:           false;
    filename:         "system-search";
    size:             18px;
    vertical-align:   0.5;
}

prompt {
    text-color:       @teal-bright;
    vertical-align:   0.5;
}

entry {
    text-color:       @fg-white;
    placeholder:      "Search apps...";
    placeholder-color:@fg-muted;
    vertical-align:   0.5;
}

/* --- 2 Kolom Grid --- */
listview {
    columns:          2;
    lines:            6;
    spacing:          8px;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
}

/* --- Struktur Elemen Dasar --- */
element {
    padding:          9px 12px;
    border-radius:    8px;
    spacing:          12px;
    cursor:           pointer;
    border:           1px;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    cursor:           inherit;
    text-color:       @fg-white;
}

/* ================= KUNCI ANTI-PUTIH / DARK MODE ENFORCED ================= */

/* Item Biasa & Item Baris Alternatif (Keduanya Gelap Pekat, Teks Putih) */
element normal.normal,
element alternate.normal {
    background-color: @bg-item;
    border-color:     @border-color;
}

/* Item Aktif yang Dipilih / Selected (Warna Teal, Teks Gelap Kontras) */
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @teal;
    border-color:     @teal;
}

element selected.normal element-text,
element selected.active element-text,
element selected.urgent element-text {
    text-color:       @fg-selected;
}